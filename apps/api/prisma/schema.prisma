generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  meetings     Meeting[]

  @@map("users")
}

model Meeting {
  id           String           @id @default(uuid(7)) @db.Uuid
  title        String
  date         DateTime         @db.Timestamptz(3)
  participants String[]
  ownerId      String           @map("owner_id") @db.Uuid
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  files        MeetingFile[]
  analysis     MeetingAnalysis?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerId])
  @@map("meetings")
}

enum MeetingFileKind {
  RECORDING
  TRANSCRIPT

  @@map("meeting_file_kind")
}

enum MeetingFileStatus {
  // Created with a presigned upload URL; the bytes may not be in storage yet.
  PENDING_UPLOAD
  // The upload is confirmed and waits for processing.
  QUEUED
  // A recording handed to the transcription provider; `transcriptionId` is
  // the provider's job, polled until it finishes.
  TRANSCRIBING
  // Processed: a transcript file is parsed, or a recording transcribed, into
  // `transcript`.
  READY
  // Processing gave up; `error` says why. Retry moves it back to QUEUED.
  FAILED

  @@map("meeting_file_status")
}

model MeetingFile {
  id              String            @id @default(uuid(7)) @db.Uuid
  meetingId       String            @map("meeting_id") @db.Uuid
  meeting         Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  // meetings/{meetingId}/{id}: one prefix per meeting, so deleting a meeting
  // can clear its objects in one go.
  storageKey      String            @unique @map("storage_key")
  originalName    String            @map("original_name")
  mimeType        String            @map("mime_type")
  // Bytes. Uploads are capped at 1 GB, well inside a 32-bit int.
  size            Int
  kind            MeetingFileKind
  status          MeetingFileStatus @default(PENDING_UPLOAD)
  // { language, segments: [{ start?, end?, speaker?, text }] } once READY.
  transcript      Json?
  // Why processing failed, shown to the owner. Set only when FAILED.
  error           String?
  // The transcription provider's job id while a recording is TRANSCRIBING.
  transcriptionId String?           @map("transcription_id")
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([meetingId])
  @@map("meeting_files")
}

enum MeetingAnalysisStatus {
  // Files changed since the last build; a job will (re)build it once no file
  // is still uploading or processing.
  PENDING
  // The analyzer is working on it.
  RUNNING
  READY
  // The analyzer gave up; `error` says why. Retry moves it back to PENDING.
  FAILED

  @@map("meeting_analysis_status")
}

// Summary, action items and decisions of a meeting, built from its READY
// files. One per meeting; removed when no READY file is left.
model MeetingAnalysis {
  id             String                @id @default(uuid(7)) @db.Uuid
  meetingId      String                @unique @map("meeting_id") @db.Uuid
  meeting        Meeting               @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  status         MeetingAnalysisStatus @default(PENDING)
  // The last successful build. Kept while a rebuild is PENDING or RUNNING.
  summary        String?
  // [{ text, owner?, dueDate? }]
  actionItems    Json?                 @map("action_items")
  // [string]
  decisions      Json?
  // BCP 47 tag of the language the analysis is written in.
  language       String?
  // FAILED files left out of the last build.
  skippedFileIds String[]              @default([]) @map("skipped_file_ids") @db.Uuid
  error          String?
  generatedAt    DateTime?             @map("generated_at") @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("meeting_analyses")
}
