# Copy to .env. Matches the Postgres in the root docker-compose.yml.
DATABASE_URL="postgresql://meeting_brain:meeting_brain@localhost:5432/meeting_brain"
# Signs access tokens. Must be 32+ characters when NODE_ENV=production: openssl rand -base64 48
JWT_SECRET="local-dev-secret-change-me"
# Access token lifetime: a number with s, m, h or d (e.g. 15m, 1h, 7d). Optional, defaults to 1h.
JWT_EXPIRES_IN="1h"

# Object storage for meeting files. Matches the MinIO in the root docker-compose.yml.
# Where the API reaches storage.
S3_ENDPOINT="http://localhost:9000"
# Where browsers reach it; presigned upload URLs are signed for this origin. Optional, defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT="http://localhost:9000"
S3_BUCKET="meeting-brain"
S3_ACCESS_KEY_ID="meeting_brain"
S3_SECRET_ACCESS_KEY="meeting_brain_secret"
# Optional: region (default us-east-1; R2 uses auto) and path-style URLs (default true, MinIO needs it).
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Transcription of recordings. Without a key a fake returns a canned transcript (no network, no cost);
# required when NODE_ENV=production.
ASSEMBLYAI_API_KEY=""
# How long the fake takes, in seconds (default 0). A few seconds lets you see the Transcribing status.
FAKE_TRANSCRIPTION_DELAY_SECONDS="5"

# Meeting summaries, action items and decisions (Claude). Without a key a fake writes a canned analysis;
# required when NODE_ENV=production.
ANTHROPIC_API_KEY=""
# How long the fake takes, in seconds (default 0).
FAKE_ANALYSIS_DELAY_SECONDS="3"
