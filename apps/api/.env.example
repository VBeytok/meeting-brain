# Copy to .env. Matches the Postgres in the root docker-compose.yml.
DATABASE_URL="postgresql://meeting_brain:meeting_brain@localhost:5432/meeting_brain"
# Signs access tokens. Use a long random value outside local dev: openssl rand -base64 48
JWT_SECRET="local-dev-secret-change-me"
# Access token lifetime (e.g. 15m, 1h, 7d). Optional, defaults to 1h.
JWT_EXPIRES_IN="1h"
